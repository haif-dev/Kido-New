{
  "extends": "../../packages/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/ui": ["../../packages/ui/src/index.ts"],
      "@app/ui/*": ["../../packages/ui/src/*"],
      "@app/lib": ["../../packages/lib/src/index.ts"],
      "@app/lib/*": ["../../packages/lib/src/*"],
      "@app/i18n": ["../../packages/i18n/src/index.ts"],
      "@app/i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
