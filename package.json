{
  "name": "my-app",
  "private": true,
  "version": "0.0.1",
  "description": "Babysitting marketplace for Algeria (FR + AR). Rename via scripts/rename.sh.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@app/web",
    "dev:mobile": "turbo run dev --filter=@app/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/lib/src/database.types.ts",
    "rename": "bash scripts/rename.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.101.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
